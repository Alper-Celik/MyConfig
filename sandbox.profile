# MOSTLY GENERATED BY AI
# Hardened firejail profile for AI agent / coding sandbox
# Usage:
#   firejail --profile=/home/alper/MyConfig/sandbox.profile <command>
#
# Goals:
# - Prevent the sandbox from reading password stores, encryption keys,
#   SSH/GPG/age agents, browser/email profiles, and cloud/API credentials.
# - Block network egress by default.
# - Restrict writes to only project / scratch directories.





# === D-Bus (session + system) ===
# The session bus exposes a Secret Service API (org.freedesktop.secrets) and
# KeePassXC's main-window interface, either of which can leak passwords.
# Allow notifications, block everything else on the user bus, and block the
# system bus entirely.
dbus-user filter
dbus-user.talk org.freedesktop.Notifications
dbus-system none

# === Basic sandboxing ===
caps.drop all
noroot
nogroups
nonewprivs
seccomp
ipc-namespace
machine-id
#disable-mnt
private-tmp

# === Network (disabled by default) ===
# The default firejail profile often allows full network access.
# For an AI coding agent that should not phone home, keep this line.
# If the agent genuinely needs network (e.g. LLM API calls), comment it out
# or replace with a restrictive netfilter.
# net none

# === Hardware / subsystem isolation ===
nosound
no3d
nodvd
notv
nou2f
novideo
noinput

# === Home directory policy: read-only everywhere except allowed work dirs ===
read-only ${HOME}
whitelist ${HOME}
read-write ${HOME}/Projects
read-write ${HOME}/tmp
read-write ${HOME}/MyConfig
read-write ${HOME}/Downloads

# === CRITICAL: encryption keys and password stores ===
# These are owned by you (uid 1000), so a sandbox running as you can read them
# unless explicitly blacklisted.
blacklist ${HOME}/.config/sops
blacklist ${HOME}/KeepassDB
blacklist ${HOME}/.config/keepassxc
blacklist ${HOME}/.cache/keepassxc
blacklist ${HOME}/.ssh
blacklist ${HOME}/.gnupg

# === HIGH: sync / remote access / VPN credentials ===
blacklist ${HOME}/.local/state/syncthing
blacklist ${HOME}/.config/syncthing
blacklist ${HOME}/.config/sunshine
blacklist ${HOME}/.config/Mullvad VPN
# blacklist ${HOME}/.config/gh
blacklist ${HOME}/.config/Yubico.old
blacklist ${HOME}/.local/share/containers

# === MEDIUM: browser / email / chat profiles ===
blacklist ${HOME}/.config/mozilla/
blacklist ${HOME}/.config/chromium
blacklist ${HOME}/.config/BraveSoftware
blacklist ${HOME}/.config/Google
blacklist ${HOME}/.thunderbird
blacklist ${HOME}/.config/discord
blacklist ${HOME}/.config/Vencord

# === AI agent history / state that may contain past prompts ===
# blacklist ${HOME}/.omp/agent
# blacklist /tmp/omp-shell-snapshots

# === Runtime agents and system secret directories ===
blacklist ${RUNUSER}/ssh-agent
blacklist ${RUNUSER}/gnupg
blacklist ${RUNUSER}/app
blacklist ${RUNUSER}/keyring
blacklist ${RUNUSER}/bus
blacklist /run/secrets
blacklist /run/secrets.d

# # === Optional: further lock down /run/user noise ===
# blacklist ${RUNUSER}/pipewire
# blacklist ${RUNUSER}/pulse
#


read-write ${HOME}/.local

read-write ${HOME}/.local/share/zoxide
read-write ${HOME}/.omp
read-write ${HOME}/.local/share/fish
read-only ${HOME}/.local/share/fish/generated_completions/
read-only ${HOME}/.local/share/fish/home-manager/

whitelist ${HOME}/.config
whitelist ${HOME}/.cache


whitelist ${HOME}/.config
whitelist ${HOME}/.config/gh
read-write ${HOME}/.config/gh
