// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
   "pop_to_root_on_close": false,
   "escape_key_behavior": "close_window",
   "keybinding": "vim",
   "font": {
      "rendering": "qt",
      "normal": {
         "family": "TeX Gyre Heros",
         "size": 11
      }
   },
   "theme": {
      "dark": {
         "name": "ayu-dark"
      }
   },
   "telemetry": {
      "system_info": true
   },
   "launcher_window": {
      "rounding": 10,
      "opacity": 0.6,
      "client_side_decorations": {
         "border_width": 1,
         "shadow_size": 12
      },
      "compact_mode": {
         "enabled": false
      },
      "material": "blur"
   },
   "providers": {
      "@c4n4m1/vicinae-extension-zoxide-recent-directories-0": {
         "preferences": {
            "application": "kitty"
         },
         "entrypoints": {
            "recent-directories": {
               "alias": "!z"
            }
         }
      },
      "@dagimg-dot/vicinae-extension-wifi-commander-0": {
         "preferences": {
            "network-cli-tool": "nmcli"
         },
         "entrypoints": {
            "scan-wifi": {
               "alias": "!n"
            }
         }
      },
      "@knoopx/store.vicinae.systemd": {
         "entrypoints": {
            "services": {
               "alias": "!s"
            }
         }
      },
      "@knoopx/vicinae-extension-firefox-0": {
         "preferences": {
            "profile_dir": ".config/mozilla/firefox/"
         },
         "entrypoints": {
            "bookmarks": {
               "alias": "!fb"
            },
            "history": {
               "alias": "!fh"
            }
         }
      },
      "@knoopx/vicinae-extension-github-0": {
         "entrypoints": {
            "myRepositories": {
               "alias": "!g"
            },
            "workflowRuns": {
               "alias": "!r"
            }
         }
      },
      "@system7/vicinae-extension-keepassxc-0": {
         "enabled": false,
         "preferences": {
            "database": "/home/alper/KeepassDB/Passwords.kdbx"
         }
      },
      "applications": {
         "preferences": {
            "defaultAction": "focus",
            "launchPrefix": "systemd-run --user --",
            "paths": [
               "/home/alper/.local/share/applications",
               "/nix/store/a3m5ybzd33m0rrqc0lxbfk2s47qhgl1b-vicinae-0.23.2/share/applications",
               "/nix/store/aqxpzr68nhhzac7ymvvp6ss60hpv8jwz-cups-2.4.19/share/applications",
               "/nix/store/z9dlh8l5vx8174gg2h5fqqcsx482cyav-cups-2.4.19-lib/share/applications",
               "/nix/store/myjvqwq5i784sz8p75xh5rwab0lm09fz-fontconfig-2.18.2-lib/share/applications",
               "/nix/store/y4xap6rycqh553fz1ms0xfmw18bdlwcf-util-linux-2.42.2-lib/share/applications",
               "/nix/store/pyrvwmigi6qdpz9lbbslj5771pfl7r69-systemd-261.1/share/applications",
               "/nix/store/z90qxq32ss488dazcqwvnjq7sgabqcxs-glib-2.88.3/share/applications",
               "/nix/store/sq7c80pva0lk51gn7fbgycr0gaw001pn-gettext-1.0/share/applications",
               "/nix/store/pkrdhwh7fl44csni2pyw55lcrpbdxl4k-libqalculate-5.12.0/share/applications",
               "/nix/store/8inbzdcgqf75aqvs6d8878k3k13c6da4-syntax-highlighting-6.29.0/share/applications",
               "/nix/store/jj8r35y8yr3grhlxb9ya2yr0s4aqhm1g-desktops/share/applications",
               "/home/alper/.local/share/flatpak/exports/share/applications",
               "/var/lib/flatpak/exports/share/applications",
               "/home/alper/.nix-profile/share/applications",
               "/nix/profile/share/applications",
               "/home/alper/.local/state/nix/profile/share/applications",
               "/etc/profiles/per-user/alper/share/applications",
               "/nix/var/nix/profiles/default/share/applications",
               "/run/current-system/sw/share/applications"
            ]
         }
      },
      "system": {
         "entrypoints": {
            "run": {
               "alias": ">",
               "preferences": {
                  "default-action": "run-in-terminal-hold"
               }
            },
            "toggle-mute": {
               "alias": "!m"
            },
            "volume-0": {
               "enabled": false
            },
            "volume-100": {
               "enabled": false
            },
            "volume-25": {
               "enabled": false
            },
            "volume-50": {
               "enabled": false
            },
            "volume-75": {
               "enabled": false
            },
            "volume-down": {
               "enabled": false
            },
            "volume-up": {
               "enabled": false
            }
         }
      },
      "wm": {
         "entrypoints": {
            "switch-windows": {
               "alias": "!w"
            }
         }
      }
   }
}