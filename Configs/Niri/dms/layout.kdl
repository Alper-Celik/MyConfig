// ! DO NOT EDIT !
// ! AUTO-GENERATED BY DMS !
// ! CHANGES WILL BE OVERWRITTEN !
// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

layout {
    gaps 20

    border {
        width 1
    }

    focus-ring {
        width 1
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}

blur {
    passes 3
    offset 6.9
}

layer-rule {
    exclude namespace="^dms:bar$"
    exclude namespace="^dms:dankisland$"
    background-effect {
        xray false
    }
}

window-rule {
    match app-id="^(dev.duxlabs.shell|com.danklinux.dms)$"
    background-effect {
        xray false
    }
}
