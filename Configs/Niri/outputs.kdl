// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The built-in laptop monitor is usually called "eDP-1".
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Outputs

output "BOE NE173QHM-NZ2 Unknown"{
  mode "2560x1440@240.001"
  scale 1.25
}

output "Samsung Electric Company SyncMaster HMDSB05010"{
  mode "1440x900@74.984"
  scale 1
}


output "Samsung Electric Company LS27D60xU HK2XC00109" {
  mode "2560x1440@99.946"
  position x=0 y=0
}
output "Samsung Electric Company LS27D60xU HK2XC00207" {
  mode "2560x1440@99.946"
  position x=2560 y=-575
  transform "270"
}
output   "Valve Corporation ANX7530 U 0x00000001" {
  position x=640 y=1440
  // transform "90"
  scale 1.125
}


