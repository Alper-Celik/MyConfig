#! /bin/sh
# Sandboxed omp: firejail with the MyConfig profile, whitelisting $PWD (or the vault the
# caller names) on top of the profile's own whitelists.
#
#   interactive:           omp-sandboxed [args...]     yolo, stays in $PWD
#   Obsidian Copilot ACP:  omp-sandboxed acp --cwd <vault>
#     Copilot hands its system prompt to opencode via OPENCODE_CONFIG_CONTENT, which omp
#     ignores; it is forwarded as --append-system-prompt.
set -eu

# gh / GitHub auth for both the native github tool and shell `gh`: sandbox.profile does not
# whitelist ~/.config/gh, so the CLI cannot read its own credential store inside the jail —
# the sops-managed PAT is passed by env instead.
# gh spawns (native tool) inherit process.env, so this covers both paths.
GH_TOKEN=$(cat "${HOME:-/home/alper}/.omp/agent/secrets/github-mcp-authorization")
export GH_TOKEN

# git identity for agent-authored commits: ~/.gitconfig is not visible inside the jail either,
# so point git at the repo-managed identity (email = the GitHub account address for the PAT above).
GIT_CONFIG_GLOBAL=/home/alper/MyConfig/Configs/Omp/gitconfig
export GIT_CONFIG_GLOBAL

case "${1:-}" in
  acp) ;; # the ACP client drives the flags
  *) set -- --yolo --allow-home "$@" ;;
esac

vault=
prev=
for arg in "$@"; do
  if [ "$prev" = "--cwd" ]; then vault=$arg; break; fi
  prev=$arg
done
vault=${vault:-$PWD}

prompt_dir=${HOME:-/home/alper}/.omp/cache
prompt_file=$prompt_dir/obsidian-copilot-append-system-prompt.md
if [ -n "${OPENCODE_CONFIG_CONTENT:-}" ]; then
  jq_bin=$(command -v jq || echo /run/current-system/sw/bin/jq)
  prompt=$(printf '%s' "$OPENCODE_CONFIG_CONTENT" | "$jq_bin" -r '(.agent["copilot-build"].prompt // .agent.build.prompt
    // ([.agent[]?.prompt | select(type == "string")] | first) // empty)' 2>/dev/null || true)
  # the prompt is multi-KB and omp rejects argv over 4128 bytes, so hand it over as a file
  # (omp reads the path's contents); ~/.omp is inside the profile's whitelists.
  if [ -n "$prompt" ] && mkdir -p "$prompt_dir" 2>/dev/null &&
     printf '%s' "$prompt" > "$prompt_file" 2>/dev/null; then
    set -- "$@" --append-system-prompt "$prompt_file"
  fi
fi

cache=${HOME:-/home/alper}/.obsidian-copilot
if [ -d "$cache" ]; then
  exec firejail --profile=/home/alper/MyConfig/sandbox.profile \
    --whitelist="$vault" --whitelist="$cache" omp "$@"
fi
exec firejail --profile=/home/alper/MyConfig/sandbox.profile \
  --whitelist="$vault" omp "$@"
